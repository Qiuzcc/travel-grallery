# 高德地图 JS API Key
# 申请地址: https://console.amap.com/dev/key/app
# 选择「Web端(JS API)」类型
VITE_AMAP_KEY=你的高德地图API_Key
# 高德地图安全密钥（2021年12月后创建的Key必须配置）
# 在高德开放平台控制台 -> 应用管理 -> 查看Key对应的安全密钥
VITE_AMAP_SECURITY_CODE=你的安全密钥
# 高德地图 REST API Key
# 选择「Web服务」类型，用于服务端逆地理编码等接口调用
VITE_AMAP_REST_API_KEY=你的REST_API_Key

# ========== 阿里云 OSS 配置 ==========
# 用于将构建产物增量上传至阿里云对象存储
# 文档: https://help.aliyun.com/document_detail/31947.html

# OSS Bucket 所在地域 (如 oss-cn-hangzhou, oss-cn-guangzhou 等)
OSS_REGION=oss-cn-xx
# OSS Bucket 名称
OSS_BUCKET=your-bucket-name
# 阿里云 AccessKey ID (建议使用 RAM 子账号，仅授予 OSS 写入权限)
OSS_ACCESS_KEY_ID=your-access-key-id
# 阿里云 AccessKey Secret
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 上传到 OSS 的目标路径前缀 (末尾带 /)
OSS_PREFIX=xx/
